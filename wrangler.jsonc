{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "closerpitchdeck",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-06",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "durable_objects": {
    "bindings": [{ "name": "PITCH_PROSPECTS", "class_name": "PitchProspects" }]
  },
  "migrations": [{ "tag": "prospects-v1", "new_sqlite_classes": ["PitchProspects"] }],
  "observability": {
    "enabled": true
  }
}
